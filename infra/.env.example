# Copiar a infra/.env y reemplazar valores. Nunca commitear infra/.env
COMPOSE_PROJECT_NAME=tiquetera

POSTGRES_DB=tiquetera
POSTGRES_USER=tiquetera_owner
POSTGRES_PASSWORD=change-me-strong-password
# Puerto expuesto solo en localhost para desarrollo
POSTGRES_HOST_PORT=5442
# Rol sin privilegios que usa la API. Evitar caracteres reservados de URL en ambas contraseñas
APP_DB_PASSWORD=change-me-app-password

# Admin inicial (make seed). Contraseña de al menos 10 caracteres
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_ADMIN_NOMBRE=Administrador

# Semilla Ed25519 de los JWT. Generar con: openssl rand -base64 32
JWT_PRIVATE_KEY=change-me-openssl-rand-base64-32
# true solo detrás de un proxy propio (Caddy en prod), que añade X-Forwarded-For
TRUST_PROXY_HEADERS=false

TZ=America/Bogota

APP_ENV=dev
LOG_LEVEL=info
DB_MAX_CONNS=10
API_HOST_PORT=8088
